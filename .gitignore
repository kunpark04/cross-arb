# secrets & credentials
scripts/.env
*.pem
*.key

# raw API pulls / scratch data
scripts/_data/

# python
__pycache__/
*.pyc

# rust (bot-rs) — build artifacts only; src + Cargo.toml + Cargo.lock ARE tracked
bot-rs/target/
# bot-rs runtime secrets (keys + env) — NEVER committed; the read-write key lives external
bot-rs/.env
bot-rs/*.pem
bot-rs/*.key
# bot-rs execution log (runtime audit trail; CROSSARB_EXEC_LOG, default executions.jsonl) — never committed
executions.jsonl
**/executions.jsonl
# bot stdout logs + dry-run exec log (runtime artifacts) — never committed
bot-live.out
**/bot-live.out
executions.dryrun.jsonl
**/executions.dryrun.jsonl
