# bot-rs runtime env — copy to `bot-rs/.env` (gitignored) and fill in. Loaded by dotenvy at startup.
# SAFE BY DEFAULT: leave the safety vars at their defaults; the read-write key stays EXTERNAL (a path
# below), never copied into the repo. See bot-rs/README.md + decision 0015.

# --- execution safety ---
EXECUTION_MODE=dry-run            # dry-run (default) | live
VENUE_ENV=demo                   # demo (sandbox, default) | prod
# CROSSARB_I_UNDERSTAND_PROD=yes # REQUIRED to start in live + prod
# CROSSARB_KILL=1                # global kill switch -> halt all trading

# --- credentials (external paths / ids; the OWNER supplies these; gitignored) ---
KALSHI_RW_KEY_PATH=              # filesystem path to the Kalshi read-write RSA private key (.pem)
KALSHI_ACCESS_KEY=              # Kalshi access-key id
PMUS_ACCESS_KEY=               # polymarket.us access-key id
PMUS_SECRET=                   # polymarket.us Ed25519 secret (base64)

# --- risk caps (staged-rollout floor; raise deliberately when deploying) ---
MAX_CONTRACTS_PER_PAIR=1
MAX_NOTIONAL_PER_PAIR=1
MAX_TOTAL_NOTIONAL=20
# EDGE_FLOOR_CENTS=2.0
# MAX_DAYS_TO_EVENT=2.0
# ASSUME_SPORTS_SETTLED=false
# ASSUME_ECON_SETTLED=false
# SKIP_DEAR_LED_WEATHER=true
# FAT_EDGE_SIZE_FACTOR=0.5
