# Cross-arb credentials — copy to scripts/.env and fill in. NEVER commit real secrets.
# NOTE: market DATA on both venues is PUBLIC (no auth). These are only needed to PLACE ORDERS.

# --- polymarket.us (QCX) --- generate at https://polymarket.us/developer (KYC-verified account)
PMUS_ACCESS_KEY=your-key-id-uuid
PMUS_SECRET=your-base64-ed25519-secret           # shown once at creation

# --- Kalshi --- generate at https://kalshi.com/account/profile -> API Keys
KALSHI_ACCESS_KEY=your-kalshi-key-id
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem  # RSA private key file (downloaded once)
